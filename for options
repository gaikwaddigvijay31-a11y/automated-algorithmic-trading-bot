import requests
import pandas as pd
import numpy as np
import datetime as dt
import time
import math
import logging
import json
import os
import sys

# =========================
# CONFIG
# =========================
ACCESS_TOKEN = ""
BASE_URL = "https://api.upstox.com/v2"

# NIFTY SPOT (for signal)
NIFTY_SPOT_KEY = "NSE_INDEX|Nifty 50"

# OPTION INSTRUMENT KEYS (ATM CE & PE - replace daily)
OPTION_CE_KEY = "NSE_FO|XXXXCE"
OPTION_PE_KEY = "NSE_FO|XXXXPE"

INTERVAL = "1minute"

FAST_EMA = 20
SLOW_EMA = 40
ATR_LEN = 14
ADX_LEN = 14

STOP_ATR = 1.5
TAKE_ATR = 3

INITIAL_CAPITAL = 50000
RISK_PER_TRADE = 0.01
MAX_DAILY_DRAWDOWN = 0.03

STATE_FILE = "options_engine_state.json"

# =========================
# LOGGING
# =========================
logging.basicConfig(
    filename="options_trading.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

headers = {
    "Authorization": f"Bearer {ACCESS_TOKEN}",
    "Accept": "application/json"
}

# =========================
# STATE
# =========================
def load_state():
    today = dt.date.today().isoformat()

    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r") as f:
            state = json.load(f)

        if state.get("date") != today:
            state["daily_loss"] = 0
            state["date"] = today
            save_state(state)

        return state

    return {
        "capital": INITIAL_CAPITAL,
        "position": 0,
        "entry_price": None,
        "option_type": None,
        "daily_loss": 0,
        "date": today
    }

def save_state(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f)

state = load_state()

# =========================
# API WRAPPER
# =========================
def safe_request(url):
    r = requests.get(url, headers=headers, timeout=10)

    if r.status_code != 200:
        raise Exception(r.text)

    data = r.json()

    if "data" not in data:
        raise Exception(data)

    return data

# =========================
# HISTORICAL
# =========================
def get_history(instrument):
    to_date = dt.datetime.now().strftime("%Y-%m-%d")
    from_date = (dt.datetime.now() - dt.timedelta(days=3)).strftime("%Y-%m-%d")

    url = f"{BASE_URL}/historical-candle/{instrument}/{INTERVAL}/{to_date}/{from_date}"
    data = safe_request(url)

    candles = data["data"]["candles"]

    df = pd.DataFrame(
        candles,
        columns=["time","open","high","low","close","volume","oi"]
    )

    df["time"] = pd.to_datetime(df["time"])
    df = df.sort_values("time").reset_index(drop=True)

    return df

# =========================
# INDICATORS
# =========================
def compute_indicators(df):

    df['ema_fast'] = df['close'].ewm(span=FAST_EMA, adjust=False).mean()
    df['ema_slow'] = df['close'].ewm(span=SLOW_EMA, adjust=False).mean()

    tr = pd.concat([
        df['high'] - df['low'],
        abs(df['high'] - df['close'].shift()),
        abs(df['low'] - df['close'].shift())
    ], axis=1).max(axis=1)

    df['atr'] = tr.rolling(ATR_LEN).mean()

    up_move = df['high'].diff()
    down_move = -df['low'].diff()

    plus_dm = np.where((up_move > down_move) & (up_move > 0), up_move, 0)
    minus_dm = np.where((down_move > up_move) & (down_move > 0), down_move, 0)

    plus_di = 100 * (pd.Series(plus_dm).rolling(ADX_LEN).mean() / df['atr'])
    minus_di = 100 * (pd.Series(minus_dm).rolling(ADX_LEN).mean() / df['atr'])

    dx = 100 * (abs(plus_di - minus_di) / (plus_di + minus_di))
    df['adx'] = dx.rolling(ADX_LEN).mean()

    return df

# =========================
# ORDER
# =========================
def place_order(instrument, side, qty):

    url = f"{BASE_URL}/order/place"

    payload = {
        "instrument_key": instrument,
        "transaction_type": side,
        "quantity": int(qty),
        "order_type": "MARKET",
        "product": "D",
        "validity": "DAY"
    }

    r = requests.post(url, headers=headers, json=payload)

    if r.status_code != 200:
        logging.error(r.text)
        return False

    logging.info(r.text)
    return True

# =========================
# MARKET HOURS
# =========================
def market_open():
    now = dt.datetime.now()
    start = now.replace(hour=9, minute=15, second=0, microsecond=0)
    end = now.replace(hour=15, minute=25, second=0, microsecond=0)
    return start <= now <= end

print("Options Engine Started...")

while True:

    if not market_open():
        time.sleep(30)
        continue

    try:
        spot_df = compute_indicators(get_history(NIFTY_SPOT_KEY))
        latest = spot_df.iloc[-1]
        prev = spot_df.iloc[-2]

        if np.isnan(latest['adx']) or latest['adx'] < 20:
            time.sleep(60)
            continue

        if state["daily_loss"] >= INITIAL_CAPITAL * MAX_DAILY_DRAWDOWN:
            sys.exit()

        # ENTRY
        if state["position"] == 0:

            risk_amount = state["capital"] * RISK_PER_TRADE

            # Bullish → Buy CE
            if prev['ema_fast'] < prev['ema_slow'] and latest['ema_fast'] > latest['ema_slow']:

                option_df = compute_indicators(get_history(OPTION_CE_KEY))
                option_price = option_df.iloc[-1]['close']
                atr = option_df.iloc[-1]['atr']

                stop = option_price - STOP_ATR * atr
                risk_per_lot = option_price - stop

                qty = math.floor(risk_amount / risk_per_lot)

                if qty > 0 and place_order(OPTION_CE_KEY, "BUY", qty):
                    state["position"] = qty
                    state["entry_price"] = option_price
                    state["option_type"] = "CE"
                    save_state(state)

            # Bearish → Buy PE
            elif prev['ema_fast'] > prev['ema_slow'] and latest['ema_fast'] < latest['ema_slow']:

                option_df = compute_indicators(get_history(OPTION_PE_KEY))
                option_price = option_df.iloc[-1]['close']
                atr = option_df.iloc[-1]['atr']

                stop = option_price - STOP_ATR * atr
                risk_per_lot = option_price - stop

                qty = math.floor(risk_amount / risk_per_lot)

                if qty > 0 and place_order(OPTION_PE_KEY, "BUY", qty):
                    state["position"] = qty
                    state["entry_price"] = option_price
                    state["option_type"] = "PE"
                    save_state(state)

        # EXIT
        else:

            key = OPTION_CE_KEY if state["option_type"] == "CE" else OPTION_PE_KEY
            option_df = compute_indicators(get_history(key))
            latest_opt = option_df.iloc[-1]

            entry = state["entry_price"]
            stop = entry - STOP_ATR * latest_opt['atr']
            target = entry + TAKE_ATR * latest_opt['atr']

            if (latest_opt['low'] <= stop or
                latest_opt['high'] >= target):

                if place_order(key, "SELL", state["position"]):

                    pnl = (latest_opt['close'] - entry) * state["position"]
                    state["capital"] += pnl

                    if pnl < 0:
                        state["daily_loss"] += abs(pnl)

                    state["position"] = 0
                    state["entry_price"] = None
                    state["option_type"] = None
                    save_state(state)

        time.sleep(60)

    except Exception as e:
        logging.error(e)
        time.sleep(10)
